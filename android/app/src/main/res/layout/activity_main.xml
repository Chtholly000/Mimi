<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="20dp" android:paddingBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="54dp" android:layout_height="54dp"
                    android:src="@drawable/mimi_brand" android:contentDescription="@string/brand_description" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/app_name" android:textSize="27sp"
                        android:fontFamily="sans-serif-black" android:letterSpacing="-0.045"
                        android:includeFontPadding="false" android:textColor="@color/mimi_text" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/home_kicker" android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Mimi.Label" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/go_settings"
                    style="@style/Widget.Mimi.Button.Secondary" android:layout_width="48dp" android:layout_height="48dp"
                    android:minWidth="0dp" android:padding="12dp" android:contentDescription="@string/open_settings"
                    app:icon="@drawable/ic_settings" app:iconSize="20dp" app:iconPadding="0dp" app:iconGravity="textStart" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:text="@string/home_title"
                android:textColor="@color/mimi_text" android:textSize="26sp" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/home_description"
                android:textColor="@color/mimi_muted" android:textSize="13sp" android:lineSpacingExtra="4dp" />

            <app.yuxino.mimi.android.SubtitlePreviewView android:id="@+id/subtitle_preview"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                android:clickable="true" android:focusable="true" android:contentDescription="@string/home_edit_appearance" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="28dp">
                <LinearLayout android:id="@+id/source_language_action" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:minHeight="64dp" android:gravity="center_vertical"
                    android:padding="12dp" android:background="@drawable/mimi_surface" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/home_source" android:textAppearance="@style/TextAppearance.Mimi.Label" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/source_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:drawableEndCompat="@drawable/ic_expand" android:layout_marginTop="6dp" android:text="@string/lang_auto" android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/mimi_text" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_arrow" android:importantForAccessibility="no" app:tint="@color/mimi_muted" />
                <LinearLayout android:id="@+id/target_language_action" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:minHeight="64dp" android:gravity="center_vertical"
                    android:padding="12dp" android:background="@drawable/mimi_surface" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/home_target" android:textAppearance="@style/TextAppearance.Mimi.Label" />
                    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/target_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:drawableEndCompat="@drawable/ic_expand" android:layout_marginTop="6dp" android:text="@string/lang_zh" android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/mimi_text" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="22dp" android:background="@color/mimi_border" />
            <LinearLayout android:id="@+id/service_settings" android:layout_width="match_parent" android:layout_height="72dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/home_service" android:textAppearance="@style/TextAppearance.Mimi.Label" />
                    <TextView android:id="@+id/provider_summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="@color/mimi_text" />
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" app:tint="@color/mimi_muted" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/mimi_border" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="18dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_setup_status" android:textSize="12sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/mimi_text" />
        <TextView android:id="@+id/status_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/home_setup_hint"
            android:textSize="12sp" android:textColor="@color/mimi_muted" android:lineSpacingExtra="3dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_capture_diagnostics"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/copy_capture_diagnostics" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/start_stop"
            style="@style/Widget.Mimi.Button.Primary" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="16dp" android:text="@string/start_capture"
            app:icon="@drawable/ic_play" app:iconSize="18dp" app:iconPadding="8dp" app:iconGravity="textStart" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center" android:text="@string/home_privacy"
            android:textSize="11sp" android:textColor="@color/mimi_muted" />
    </LinearLayout>
</LinearLayout>
