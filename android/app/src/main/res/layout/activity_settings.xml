<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mimi_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/provider_label"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/provider_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/provider_dashscope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/provider_dashscope"
                android:textColor="@color/mimi_text" />

            <RadioButton
                android:id="@+id/provider_openai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/provider_openai"
                android:textColor="@color/mimi_text" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/api_key_label"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="sk-..."
            android:inputType="textPassword"
            android:textColor="@color/mimi_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/base_url_label"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="wss://your-proxy.example/v1/...（留空用官方）"
            android:inputType="textUri"
            android:textColor="@color/mimi_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/model_label"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="留空用默认模型"
            android:inputType="text"
            android:textColor="@color/mimi_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/source_language"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/source_lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/target_language"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/target_lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/font_size"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="24"
            android:min="12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/translation_color"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/translation_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/overlay_opacity"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/overlay_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:min="20" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/overlay_bg_alpha"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/overlay_bg_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="90"
            android:min="0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/history_lines"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/history_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="6"
            android:min="0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/hotwords_label"
            android:textColor="@color/mimi_muted"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/hotwords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/hotwords_hint"
            android:inputType="text"
            android:textColor="@color/mimi_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_position"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reset_position" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
